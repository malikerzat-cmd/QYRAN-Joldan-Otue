import pygame
import sys
import random

# Баптаулар
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
FPS = 60

# Түстер
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (200, 50, 50)
GREEN = (50, 200, 50)
YELLOW = (220, 220, 50)
BLUE = (50, 100, 200)

class Player(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        # Ойыншы бейнесі (Тіктөртбұрыш ретінде жасалған)
        self.image = pygame.Surface((40, 40))
        self.image.fill(GREEN)
        self.rect = self.image.get_rect()
        self.rect.center = (SCREEN_WIDTH // 2, SCREEN_HEIGHT - 50)
        self.speed = 5

    def update(self):
        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT] or keys[pygame.K_a]:
            self.rect.x -= self.speed
        if keys[pygame.K_RIGHT] or keys[pygame.K_d]:
            self.rect.x += self.speed
        if keys[pygame.K_UP] or keys[pygame.K_w]:
            self.rect.y -= self.speed
        if keys[pygame.K_DOWN] or keys[pygame.K_s]:
            self.rect.y += self.speed

        # Экраннан шығып кетпеуін тексеру
        if self.rect.left < 0:
            self.rect.left = 0
        if self.rect.right > SCREEN_WIDTH:
            self.rect.right = SCREEN_WIDTH
        if self.rect.top < 0:
            self.rect.top = 0
        if self.rect.bottom > SCREEN_HEIGHT:
            self.rect.bottom = SCREEN_HEIGHT

class Vehicle(pygame.sprite.Sprite):
    def __init__(self, x, y, speed):
        super().__init__()
        self.image = pygame.Surface((70, 35))
        self.image.fill(RED)
        self.rect = self.image.get_rect()
        self.rect.topleft = (x, y)
        self.speed = speed

    def update(self):
        self.rect.x += self.speed
        # Көлік экраннан шығып кетсе, қайтадан арғы бетке шығару
        if self.speed > 0 and self.rect.left > SCREEN_WIDTH:
            self.rect.right = 0
        elif self.speed < 0 and self.rect.right < 0:
            self.rect.left = SCREEN_WIDTH

class Coin(pygame.sprite.Sprite):
    def __init__(self, x, y):
        super().__init__()
        self.image = pygame.Surface((20, 20))
        self.image.fill(YELLOW)
        self.rect = self.image.get_rect()
        self.rect.center = (x, y)

class Game:
    def __init__(self):
        self.screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
        pygame.display.set_caption("Road Crossing Game")
        self.clock = pygame.time.Clock()
        
        self.player = Player()
        self.all_sprites = pygame.sprite.Group()
        self.vehicles = pygame.sprite.Group()
        self.coins = pygame.sprite.Group()
        
        self.all_sprites.add(self.player)
        
        # Көліктерді жолақтар бойынша қосу
        car_speeds = [3, -4, 5, -3]
        for i, y in enumerate([150, 230, 350, 430]):
            vehicle = Vehicle(random.randint(0, SCREEN_WIDTH), y, car_speeds[i])
            self.vehicles.add(vehicle)
            self.all_sprites.add(vehicle)
            
        # Монеталар қосу
        for _ in range(5):
            coin = Coin(random.randint(50, SCREEN_WIDTH - 50), random.randint(50, 500))
            self.coins.add(coin)
            self.all_sprites.add(coin)
            
        self.score = 0
        self.font = pygame.font.SysFont(None, 36)
        self.game_over = False

    def run(self):
        while True:
            self.handle_events()
            if not self.game_over:
                self.update()
            self.draw()
            self.clock.tick(FPS)

    def handle_events(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            if event.type == pygame.KEYDOWN and self.game_over:
                if event.key == pygame.K_r:
                    # Ойынды қайта бастау
                    self.__init__()

    def update(self):
        self.all_sprites.update()
        
        # Көлікпен соқтығысуды тексеру
        if pygame.sprite.spritecollideany(self.player, self.vehicles):
            self.game_over = True
            
        # Монета жинауды тексеру
        collected_coins = pygame.sprite.spritecollide(self.player, self.coins, True)
        for coin in collected_coins:
            self.score += 1
            # Жиналып бітсе, жаңа монета шығару
            new_coin = Coin(random.randint(50, SCREEN_WIDTH - 50), random.randint(50, 500))
            self.coins.add(new_coin)
            self.all_sprites.add(new_coin)

    def draw(self):
        self.screen.fill(BLACK)
        
        # Жол сызықтарын салу (визуалды түрде)
        pygame.draw.rect(self.screen, (50, 50, 50), (0, 120, SCREEN_WIDTH, 360))
        for y in [120, 210, 310, 400, 480]:
            pygame.draw.line(self.screen, WHITE, (0, y), (SCREEN_WIDTH, y), 2)

        self.all_sprites.draw(self.screen)
        
        # Ұпайды көрсету
        score_text = self.font.render(f"Ұпай: {self.score}", True, WHITE)
        self.screen.blit(score_text, (20, 20))
        
        if self.game_over:
            over_text = self.font.render("Ойын бітті! Қайта бастау үшін 'R' басыңыз", True, RED)
            self.screen.blit(over_text, (SCREEN_WIDTH // 2 - 220, SCREEN_HEIGHT // 2))
            
        pygame.display.flip()

if __name__ == "__main__":
    pygame.init()
    game = Game()
    game.run()
